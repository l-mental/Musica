<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>Compositor de partituras - EMMFAB</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/abcjs@6.2.0/dist/abcjs-basic-min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <style>
    #abc-preview svg {
      max-width: 100%;
      height: auto;
      background: white;
      margin-top: 1rem;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    }
  </style>
</head>
<body class="bg-gray-100">
  <nav class="bg-purple-900 text-white p-4 shadow-lg">
    <div class="container mx-auto flex justify-between items-center">
      <span class="font-bold text-xl">🎼 Compositor de Partituras</span>
      <div>
        <a href="/admin" class="bg-purple-700 px-3 py-1 rounded mr-2">Volver al Panel</a>
        <a href="/" class="bg-green-600 px-3 py-1 rounded mr-2">Inicio</a>
        <a href="/logout" class="bg-red-600 px-3 py-1 rounded">Salir</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-4 md:p-8">
    <h1 class="text-3xl font-bold text-purple-800 mb-2">✍️ Crear nueva partitura</h1>
    <p class="mb-6 text-gray-600">Escribe tu música usando <a href="https://abcnotation.com/examples" target="_blank" class="text-blue-600 underline">notación ABC</a>. Visualiza y descarga en PDF.</p>

    <div class="grid md:grid-cols-2 gap-6">
      <div class="bg-white p-4 rounded-xl shadow">
        <h2 class="text-xl font-bold mb-3">Código ABC</h2>
        <textarea id="abc-input" rows="15" class="w-full border rounded p-2 font-mono text-sm">
X:1
T:Mi Morenada
M:2/4
L:1/8
K:C
|:"C"E2 E2|"G"G2 G2|"C"E2 E2|"G"G2 G2|"C"c2 c2|"G"B2 B2|"C"c2 c2|"G"B2 B2|
|:"C"c2 e2|d2 c2|"G"B2 G2|A2 B2|"C"c2 e2|d2 c2|"G"B2 G2|"C"A2 G2|]
        </textarea>
        <button id="update-preview" class="mt-3 bg-blue-600 text-white px-4 py-2 rounded w-full">Actualizar vista previa</button>
      </div>
      <div class="bg-white p-4 rounded-xl shadow">
        <h2 class="text-xl font-bold mb-3">🎵 Vista previa</h2>
        <div id="abc-preview" class="min-h-[300px] overflow-auto"></div>
        <button id="export-pdf" class="mt-4 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded w-full">📄 Exportar a PDF</button>
        <p class="text-xs text-gray-500 mt-3">* El PDF se descargará. Luego súbelo desde el panel de administración.</p>
      </div>
    </div>
    <div class="mt-6 p-4 bg-yellow-50 border-l-4 border-yellow-400 rounded">
      <p class="text-sm text-yellow-800"><strong>💡 Consejo:</strong> Aprende la sintaxis ABC en <a href="https://abcnotation.com/examples" class="underline" target="_blank">abcnotation.com/examples</a>. Puedes empezar con el ejemplo de Morenada.</p>
    </div>
  </div>

  <script>
    function renderScore() {
      const abcCode = document.getElementById('abc-input').value;
      const container = document.getElementById('abc-preview');
      container.innerHTML = '';
      try {
        ABCJS.renderAbc(container, abcCode, { responsive: 'resize', staffwidth: 600 });
      } catch(e) {
        container.innerHTML = '<div class="text-red-500 p-4">Error en la notación ABC: ' + e.message + '</div>';
      }
    }
    document.getElementById('update-preview').addEventListener('click', renderScore);
    renderScore();

    document.getElementById('export-pdf').addEventListener('click', async () => {
      const previewDiv = document.getElementById('abc-preview');
      const canvas = await html2canvas(previewDiv, { scale: 2, backgroundColor: '#ffffff' });
      const imgData = canvas.toDataURL('image/png');
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
      const imgWidth = 280;
      const imgHeight = (canvas.height * imgWidth) / canvas.width;
      pdf.addImage(imgData, 'PNG', 5, 0, imgWidth, imgHeight);
      pdf.save(`partitura_${Date.now()}.pdf`);
    });
  </script>
</body>
</html>