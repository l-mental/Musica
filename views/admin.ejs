<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>Panel Admin - EMMFAB</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <nav class="bg-purple-900 text-white p-4 shadow-lg">
    <div class="container mx-auto flex flex-wrap justify-between items-center">
      <span class="font-bold text-xl">🔐 Panel Administrativo</span>
      <div>
        <a href="/" class="bg-purple-700 hover:bg-purple-800 px-3 py-1 rounded mr-2">Inicio</a>
        <a href="/compose" class="bg-indigo-600 hover:bg-indigo-700 px-3 py-1 rounded mr-2">🎼 Componer</a>
        <a href="/logout" class="bg-red-600 hover:bg-red-700 px-3 py-1 rounded">Cerrar sesión</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-4 md:p-8">
    <h1 class="text-3xl font-bold text-purple-800 mb-6">📌 Gestión de la Biblioteca</h1>

    <% if (error) { %>
      <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-3 mb-4 rounded"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-3 mb-4 rounded"><%= success %></div>
    <% } %>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Agregar ritmo -->
      <div class="bg-white p-5 rounded-xl shadow">
        <h2 class="text-xl font-bold mb-4">➕ Agregar nuevo ritmo</h2>
        <form method="POST" action="/admin/add-rhythm">
          <input type="text" name="rhythmName" placeholder="Ej: Huayno, Saya..." class="w-full border p-2 rounded mb-3" required>
          <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Guardar ritmo</button>
        </form>
      </div>

      <!-- Subir partitura -->
      <div class="bg-white p-5 rounded-xl shadow">
        <h2 class="text-xl font-bold mb-4">📤 Subir nueva partitura (PDF)</h2>
        <form method="POST" action="/admin/upload-score" enctype="multipart/form-data">
          <input type="text" name="title" placeholder="Título de la obra" class="w-full border p-2 rounded mb-3" required>
          <select name="rhythmId" class="w-full border p-2 rounded mb-3" required>
            <option value="">Seleccionar ritmo</option>
            <% rhythms.forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %></option>
            <% }) %>
          </select>
          <select name="instrument" class="w-full border p-2 rounded mb-3" required>
            <option value="">Seleccionar instrumento</option>
            <option value="trompeta">🎺 Trompeta</option>
            <option value="baritono">🎷 Barítono</option>
            <option value="ambos">🎺🎷 Ambos</option>
          </select>
          <input type="file" name="pdf" accept="application/pdf" class="w-full border p-2 rounded mb-3" required>
          <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 w-full">Subir PDF</button>
        </form>
      </div>
    </div>

    <!-- Lista de ritmos con opciones editar/eliminar -->
    <div class="mt-10 bg-white p-5 rounded-xl shadow">
      <h2 class="text-xl font-bold mb-3">🎵 Ritmos existentes (<%= rhythms.length %>)</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <% rhythms.forEach(r => { %>
          <div class="bg-gray-50 p-3 rounded-lg flex justify-between items-center">
            <span class="font-medium"><%= r.name %></span>
            <div>
              <button onclick="editRhythm(<%= r.id %>, '<%= r.name.replace(/'/g, "\\'") %>')" class="text-blue-600 hover:text-blue-800 mr-2">✏️ Editar</button>
              <form method="POST" action="/admin/delete-rhythm/<%= r.id %>" class="inline" onsubmit="return confirm('¿Eliminar ritmo <%= r.name %>? Solo si no tiene partituras asociadas.');">
                <button type="submit" class="text-red-600 hover:text-red-800">🗑️ Eliminar</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Tabla de partituras con opciones editar/eliminar -->
    <div class="mt-10 bg-white p-5 rounded-xl shadow overflow-x-auto">
      <h2 class="text-xl font-bold mb-3">📄 Partituras en el sistema (<%= scores.length %> total)</h2>
      <table class="w-full text-sm">
        <thead class="bg-gray-200">
          <tr>
            <th class="p-2">ID</th>
            <th class="p-2">Título</th>
            <th class="p-2">Instrumento</th>
            <th class="p-2">Ritmo</th>
            <th class="p-2">Fecha</th>
            <th class="p-2">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (scores.length === 0) { %>
            <tr><td colspan="6" class="text-center p-4">No hay partituras aún. Sube una arriba.</td></tr>
          <% } else { %>
            <% scores.forEach(score => { 
               const rhythmName = rhythms.find(r => r.id === score.rhythm_id)?.name || '?';
               const instrumentName = score.instrument === 'ambos' ? 'Trompeta y Barítono' : (score.instrument === 'trompeta' ? 'Trompeta' : 'Barítono');
            %>
              <tr class="border-b hover:bg-gray-50">
                <td class="p-2"><%= score.id %></td>
                <td class="p-2 font-medium"><%= score.title %></td>
                <td class="p-2"><%= instrumentName %></td>
                <td class="p-2"><%= rhythmName %></td>
                <td class="p-2"><%= new Date(score.upload_date).toLocaleDateString() %></td>
                <td class="p-2">
                  <button onclick="editScore(<%= score.id %>, '<%= score.title.replace(/'/g, "\\'") %>', <%= score.rhythm_id %>, '<%= score.instrument %>')" class="text-blue-600 hover:text-blue-800 mr-2">✏️ Editar</button>
                  <form method="POST" action="/admin/delete-score/<%= score.id %>" class="inline" onsubmit="return confirm('¿Eliminar partitura <%= score.title %>? Se borrará el archivo PDF.');">
                    <button type="submit" class="text-red-600 hover:text-red-800">🗑️ Eliminar</button>
                  </form>
                </td>
               </tr>
            <% }) %>
          <% } %>
        </tbody>
       </table>
    </div>
  </div>

  <!-- Modal para editar ritmo -->
  <div id="editRhythmModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 w-96">
      <h3 class="text-xl font-bold mb-4">Editar ritmo</h3>
      <form id="editRhythmForm" method="POST">
        <input type="text" name="newName" id="editRhythmName" class="w-full border p-2 rounded mb-4" required>
        <div class="flex justify-end gap-2">
          <button type="button" onclick="closeModal('editRhythmModal')" class="bg-gray-300 px-4 py-2 rounded">Cancelar</button>
          <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal para editar partitura -->
  <div id="editScoreModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 w-96">
      <h3 class="text-xl font-bold mb-4">Editar partitura</h3>
      <form id="editScoreForm" method="POST">
        <input type="text" name="title" id="editScoreTitle" placeholder="Título" class="w-full border p-2 rounded mb-3" required>
        <select name="rhythmId" id="editScoreRhythm" class="w-full border p-2 rounded mb-3" required>
          <option value="">Seleccionar ritmo</option>
          <% rhythms.forEach(r => { %>
            <option value="<%= r.id %>"><%= r.name %></option>
          <% }) %>
        </select>
        <select name="instrument" id="editScoreInstrument" class="w-full border p-2 rounded mb-3" required>
          <option value="trompeta">🎺 Trompeta</option>
          <option value="baritono">🎷 Barítono</option>
          <option value="ambos">🎺🎷 Ambos</option>
        </select>
        <div class="flex justify-end gap-2">
          <button type="button" onclick="closeModal('editScoreModal')" class="bg-gray-300 px-4 py-2 rounded">Cancelar</button>
          <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function editRhythm(id, name) {
      const form = document.getElementById('editRhythmForm');
      form.action = `/admin/edit-rhythm/${id}`;
      document.getElementById('editRhythmName').value = name;
      document.getElementById('editRhythmModal').classList.remove('hidden');
      document.getElementById('editRhythmModal').classList.add('flex');
    }
    function editScore(id, title, rhythmId, instrument) {
      const form = document.getElementById('editScoreForm');
      form.action = `/admin/edit-score/${id}`;
      document.getElementById('editScoreTitle').value = title;
      document.getElementById('editScoreRhythm').value = rhythmId;
      document.getElementById('editScoreInstrument').value = instrument;
      document.getElementById('editScoreModal').classList.remove('hidden');
      document.getElementById('editScoreModal').classList.add('flex');
    }
    function closeModal(modalId) {
      document.getElementById(modalId).classList.add('hidden');
      document.getElementById(modalId).classList.remove('flex');
    }
    // Cerrar modal al hacer clic fuera
    window.onclick = function(event) {
      if (event.target.classList.contains('fixed')) {
        event.target.classList.add('hidden');
        event.target.classList.remove('flex');
      }
    }
  </script>
</body>
</html>