<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>biblioteca digital de partituras EMMFAB</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* Fondo con logo (watermark) */
    body {
      background-image: url('/img/logo-fondo.png');
      background-repeat: repeat;
      background-size: 80px;
      background-attachment: fixed;
    }
    /* Para mejorar la legibilidad, las tarjetas tendrán fondo blanco semi-transparente */
    .card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(2px);
    }
    /* Estilo del visor PDF en el modal */
    .pdf-viewer {
      width: 100%;
      height: 80vh;
      border: none;
    }
  </style>
</head>
<body class="bg-gray-100">
  <% 
    scores = typeof scores !== 'undefined' ? scores : [];
    rhythms = typeof rhythms !== 'undefined' ? rhythms : [];
    selectedInstrument = typeof selectedInstrument !== 'undefined' ? selectedInstrument : 'todos';
    selectedRhythm = typeof selectedRhythm !== 'undefined' ? selectedRhythm : '';
    isAdmin = !!isAdmin;
    function escForOnclick(str){ return String(str||'').replace(/'/g, "\\'" ).replace(/\"/g, '&quot;').replace(/\n/g,' ').replace(/\r/g,''); }
  %>
  <nav class="bg-purple-800 text-white p-4 shadow-lg sticky top-0 z-10">
    <div class="container mx-auto flex flex-wrap justify-between items-center">
      <div class="flex items-center gap-2">
        <img src="/img/FABLOGO.jpeg" class="h-10 w-10 rounded-full object-cover" onerror="this.src='https://via.placeholder.com/40'">
        <span class="font-bold text-xl">EMMFAB · Biblioteca</span>
      </div>
      <div class="flex gap-4">
        <% if (isAdmin) { %>
          <a href="/admin" class="bg-yellow-500 hover:bg-yellow-600 px-3 py-1 rounded">Admin</a>
        <% } %>
        <a href="/logout" class="bg-red-600 hover:bg-red-700 px-3 py-1 rounded">Salir</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto px-4 py-8">
    <!-- Encabezado con imagen de carnaval -->
    <div class="relative rounded-2xl overflow-hidden mb-8 shadow-xl">
      <img src="/img/carnaval-header.jpg" class="w-full h-48 object-cover" onerror="this.src='https://placehold.co/1200x300?text=Carnaval+de+Oruro'">
      <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
        <h2 class="text-white text-3xl md:text-5xl font-bold drop-shadow">🎵 Ritmos de mi tierra 🎵</h2>
      </div>
    </div>

    <!-- Mensaje de bienvenida para llenar el vacío -->
    <div class="bg-purple-100 border-l-4 border-purple-600 text-purple-800 p-4 mb-8 rounded shadow">
      <p class="font-bold">🎶 Bienvenido a la Biblioteca Digital EMMFAB</p>
      <p>Aquí encontrarás partituras para trompeta y barítono de los ritmos más representativos del Carnaval de Oruro y música boliviana. Usa los filtros para encontrar la partitura que necesitas.</p>
    </div>

    <!-- Filtros: usamos formulario GET para evitar problemas de rutas -->
    <div class="bg-white p-4 rounded-xl shadow mb-8">
      <h3 class="font-bold text-lg mb-3">🎭 Clasificación por ritmo</h3>
      <form method="GET" action="/" id="filterForm" class="flex flex-wrap gap-2 max-h-60 overflow-y-auto pb-2">
        <input type="hidden" name="instrument" value="<%= selectedInstrument %>">
        <button type="submit" name="rhythm" value="" class="px-4 py-2 rounded-full <%= !selectedRhythm ? 'bg-purple-600 text-white' : 'bg-gray-200 hover:bg-gray-300' %>">Todos</button>
        <% rhythms.forEach(r => { %>
          <button type="submit" name="rhythm" value="<%= r.name %>" class="px-4 py-2 rounded-full <%= selectedRhythm === r.name ? 'bg-purple-600 text-white' : 'bg-gray-200 hover:bg-gray-300' %>">
            <%= r.name %>
          </button>
        <% }) %>
      </form>
    </div>

    <!-- Filtro por especialidad (también con botones) -->
    <div class="bg-white p-4 rounded-xl shadow mb-8">
      <h3 class="font-bold text-lg mb-3">🎺 Especialidad</h3>
      <div class="flex flex-wrap gap-2">
        <a href="/?rhythm=<%= selectedRhythm %>&instrument=todos" class="px-4 py-2 rounded-full <%= selectedInstrument === 'todos' ? 'bg-purple-600 text-white' : 'bg-gray-200 hover:bg-gray-300' %>">Todos</a>
        <a href="/?rhythm=<%= selectedRhythm %>&instrument=trompeta" class="px-4 py-2 rounded-full <%= selectedInstrument === 'trompeta' ? 'bg-purple-600 text-white' : 'bg-gray-200 hover:bg-gray-300' %>">🎺 Trompeta</a>
        <a href="/?rhythm=<%= selectedRhythm %>&instrument=baritono" class="px-4 py-2 rounded-full <%= selectedInstrument === 'baritono' ? 'bg-purple-600 text-white' : 'bg-gray-200 hover:bg-gray-300' %>">🎷 Barítono</a>
      </div>
    </div>

    <!-- Contador de resultados -->
    <div class="text-right text-gray-500 mb-4">
      <%= scores.length %> partitura(s) encontrada(s)
    </div>

    <!-- Lista de partituras con vista previa -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% if (scores.length === 0) { %>
        <div class="col-span-full text-center py-12 bg-white rounded-xl shadow card">
          <p class="text-gray-500 text-lg">📭 No hay partituras disponibles con estos filtros.</p>
          <% if (isAdmin) { %>
            <a href="/admin" class="inline-block mt-4 bg-purple-600 text-white px-4 py-2 rounded">Subir primera partitura</a>
          <% } %>
        </div>
      <% } else { %>
        <% scores.forEach(score => { %>
          <div class="card rounded-xl shadow-md overflow-hidden hover:shadow-xl transition">
            <div class="p-5">
              <div class="flex justify-between items-start">
                <h3 class="font-bold text-xl text-purple-800"><%= score.title %></h3>
                <span class="bg-amber-100 text-amber-800 text-xs px-2 py-1 rounded-full"><%= score.rhythm_name %></span>
              </div>
              <p class="text-gray-500 text-sm mt-2">
                🎵 <%= score.instrument === 'ambos' ? 'Trompeta y Barítono' : (score.instrument === 'trompeta' ? 'Trompeta' : 'Barítono') %>
              </p>
              <p class="text-gray-500 text-sm">📅 <%= new Date(score.upload_date).toLocaleDateString() %></p>
              <div class="mt-4 flex gap-2 flex-wrap">
                <a href="/download/<%= score.id %>" class="flex-1 bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-lg text-center text-sm">📥 Descargar</a>
                <button onclick="openPDFPreview('/download/<%= score.id %>')" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-2 rounded-lg text-sm">🔍 Vista previa</button>
                <% if (isAdmin) { %>
                  <button type="button" class="edit-score-btn bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-2 rounded-lg text-sm" data-id="<%= score.id %>" data-title="<%= (score.title||'').replace(/\"/g, '&quot;') %>" data-rhythm="<%= score.rhythm_id %>" data-instrument="<%= score.instrument %>">✏️</button>
                  <button type="button" class="delete-score-btn bg-red-500 hover:bg-red-600 text-white px-3 py-2 rounded-lg text-sm" data-id="<%= score.id %>" data-title="<%= (score.title||'').replace(/\"/g, '&quot;') %>">🗑️</button>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <footer class="text-center text-gray-500 text-sm py-6 border-t mt-8">
    Biblioteca EMMFAB - Música del Carnaval de Oruro 🇧🇴
  </footer>

  <!-- Modal para vista previa de PDF -->
  <div id="pdfModal" class="fixed inset-0 bg-black bg-opacity-75 hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-lg w-full max-w-5xl mx-auto">
      <div class="flex justify-between items-center p-4 border-b">
        <h3 class="text-xl font-bold">Vista previa de la partitura</h3>
        <button onclick="closePDFModal()" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
      </div>
      <div class="p-2">
        <iframe id="pdfViewer" class="pdf-viewer" src=""></iframe>
      </div>
      <div class="p-3 text-right border-t">
        <button onclick="closePDFModal()" class="bg-gray-300 px-4 py-2 rounded">Cerrar</button>
        <a id="downloadLink" href="#" class="bg-green-600 text-white px-4 py-2 rounded ml-2 inline-block">Descargar PDF</a>
      </div>
    </div>
  </div>

  <!-- Modal para editar partitura (solo admin) -->
  <div id="editScoreModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 w-96 max-w-md mx-4">
      <h3 class="text-xl font-bold mb-4">Editar partitura</h3>
      <form id="editScoreForm" method="POST">
        <input type="text" name="title" id="editScoreTitle" placeholder="Título" class="w-full border p-2 rounded mb-3" required>
        <select name="rhythmId" id="editScoreRhythm" class="w-full border p-2 rounded mb-3" required>
          <option value="">Seleccionar ritmo</option>
          <% rhythms.forEach(r => { %>
            <option value="<%= r.id %>"><%= r.name %></option>
          <% }) %>
        </select>
        <select name="instrument" id="editScoreInstrument" class="w-full border p-2 rounded mb-3" required>
          <option value="trompeta">🎺 Trompeta</option>
          <option value="baritono">🎷 Barítono</option>
          <option value="ambos">🎺🎷 Ambos</option>
        </select>
        <div class="flex justify-end gap-2">
          <button type="button" onclick="closeModal('editScoreModal')" class="bg-gray-300 px-4 py-2 rounded">Cancelar</button>
          <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Formulario oculto para eliminar partitura -->
  <form id="deleteScoreForm" method="POST" style="display: none;"></form>

  <script>
    // Función para abrir modal de PDF
    function openPDFPreview(downloadUrl) {
      const modal = document.getElementById('pdfModal');
      const iframe = document.getElementById('pdfViewer');
      const downloadLink = document.getElementById('downloadLink');
      iframe.src = downloadUrl;
      downloadLink.href = downloadUrl;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
    function closePDFModal() {
      const modal = document.getElementById('pdfModal');
      const iframe = document.getElementById('pdfViewer');
      iframe.src = '';
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
    // Funciones para editar/eliminar (solo admin)
    function openEditModal(id, title, rhythmId, instrument) {
      const form = document.getElementById('editScoreForm');
      form.action = `/admin/edit-score/${id}`;
      document.getElementById('editScoreTitle').value = title;
      document.getElementById('editScoreRhythm').value = rhythmId;
      document.getElementById('editScoreInstrument').value = instrument;
      document.getElementById('editScoreModal').classList.remove('hidden');
      document.getElementById('editScoreModal').classList.add('flex');
    }
    function confirmDeleteScore(id, title) {
      if (confirm(`¿Eliminar la partitura "${title}"? Se borrará el archivo PDF.`)) {
        const form = document.getElementById('deleteScoreForm');
        form.action = `/admin/delete-score/${id}`;
        form.submit();
      }
    }
    function closeModal(modalId) {
      document.getElementById(modalId).classList.add('hidden');
      document.getElementById(modalId).classList.remove('flex');
    }
    // Cerrar modal al hacer clic fuera
    window.onclick = function(event) {
      if (event.target.classList && event.target.classList.contains('fixed')) {
        event.target.classList.add('hidden');
        event.target.classList.remove('flex');
      }
    }
    // Para los filtros con botones, el formulario se envía automáticamente al hacer clic en un botón.
    // No necesita código adicional.
    // Manejo de botones de editar/eliminar usando data-attributes para evitar inline onclick
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.edit-score-btn').forEach(function(btn){
        btn.addEventListener('click', function(){
          openEditModal(btn.dataset.id, btn.dataset.title, btn.dataset.rhythm, btn.dataset.instrument);
        });
      });
      document.querySelectorAll('.delete-score-btn').forEach(function(btn){
        btn.addEventListener('click', function(){
          confirmDeleteScore(btn.dataset.id, btn.dataset.title);
        });
      });
    });
  </script>
</body>
</html>